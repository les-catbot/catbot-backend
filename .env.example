APP_ENV=development
APP_DEBUG=true

DATABASE_URL=postgresql+asyncpg://catbot:catbot@localhost:5432/catbot
DATABASE_ECHO=false

# Use "memory" para testes locais sem banco, "sqlalchemy" para PostgreSQL
REPOSITORY_TYPE=memory

LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3

# Use "stub" para dev local sem modelo, "ollama" para Ollama real
EMBEDDING_TYPE=stub
EMBEDDING_MODEL=nomic-embed-text

CHUNK_SIZE=500
CHUNK_OVERLAP=100

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
