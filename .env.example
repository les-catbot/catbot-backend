APP_ENV=development
APP_DEBUG=true

DATABASE_URL=postgresql+asyncpg://catbot:catbot@db:5432/catbot
DATABASE_ECHO=false

# Use "memory" para testes locais sem banco, "sqlalchemy" para PostgreSQL
REPOSITORY_TYPE=sqlalchemy

LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.2:1b
# Use "stub" para dev local sem modelo, "ollama" para Ollama real
EMBEDDING_TYPE=ollama
EMBEDDING_MODEL=nomic-embed-text

CHUNK_SIZE=500
CHUNK_OVERLAP=100
RAG_TOP_K=5

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
